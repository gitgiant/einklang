{
  "format": 1,
  "id": "claude-media-slime",
  "name": "Media: slime feast",
  "version": 1,
  "author": { "vendor": "claude", "model": "claude-opus-5-5" },
  "status": "live",
  "created": "2026-11-27",
  "tags": ["media", "physarum", "slime-mould", "simulation", "evolving"],
  "nodes": [
    { "id": "lfo", "piece": "core-lfo", "params": { "beats": 64, "shape": 1 } },
    { "id": "pal", "piece": "core-harmony", "params": { "scheme": 2, "chroma": 0.17, "light": 0.7, "contrast": 0.6 },
      "bind": { "hue": { "from": "lfo.out", "range": [0.3, 0.8] } } },
    { "id": "media", "piece": "core-media", "params": { "beat_zoom": 0, "pulse": 0.1, "drift": 0.25, "contrast": 1.25, "saturation": 1.15 } },
    { "id": "slime", "piece": "claude-picture-slime", "params": { "agents": 300, "food": 1.2, "contrast": 1.6, "colour": 0, "under": 0.07 } },
    { "id": "fx", "piece": "core-trails", "params": { "decay": 0.35, "zoom": 0, "rotate": 0 } }
  ],
  "edges": [
    { "from": "media.luma", "to": "slime.luma" },
    { "from": "media.out", "to": "slime.in" },
    { "from": "pal.palette", "to": "slime.palette" },
    { "from": "slime.out", "to": "fx.in" }
  ],
  "out": "fx.out",
  "post": { "bloom": 0.55, "threshold": 0.65 },
  "evolve": {
    "every": "phrase", "transition": "core-blend", "beats": 4,
    "slots": [
      { "node": "slime", "pool": [
        { "piece": "claude-picture-slime", "params": { "colour": 2, "agents": 400, "under": 0.04 },
          "ranges": { "angle": [20, 60], "reach": [6, 18], "food": [0.8, 2.0] } },
        { "piece": "claude-picture-slime", "params": { "colour": 1, "contrast": 2.4, "spread": 0.8, "under": 0.1 },
          "ranges": { "turn": [20, 50], "decay": [0.85, 0.95] } },
        { "piece": "claude-picture-slime", "params": { "colour": 0, "agents": 200, "cells": 360, "steps": 3, "diffuse": 0.3, "saturation": 1.8 },
          "ranges": { "speed": [1.0, 2.2], "hunger": [0.5, 1.5] } }
      ] },
      { "node": "fx", "pool": [
        { "piece": "core-kaleido", "params": { "segments": 6 } },
        { "piece": "claude-zoomfeed", "params": { "decay": 0.7, "hue": 0.02 }, "ranges": { "decay": [0.6, 0.8] } },
        { "piece": "codex-neon-phosphor", "params": { "drive": 0.3 }, "ranges": { "drive": [0.2, 0.4] } }
      ] }
    ]
  }
}
