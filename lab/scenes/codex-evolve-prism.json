      ] },
      { "node": "lens", "jitter": 0, "pool": [
        { "piece": "claude-rotozoom", "params": { "tiles": 1.58, "zoom": 1.03, "bass": 0.49, "breathe": 0.14, "step": 0, "swing": 0.1, "spin": 0.07, "pan": 0.08, "checker": 0 } },
        { "piece": "claude-crt", "params": { "scanlines": 0.24, "curve": 0.17, "vignette": 0.22, "chroma": 0.45, "tracking": 0.55, "jitter": 0.13 } }
      ] }
