    { "id": "rows", "piece": "claude-media-ridgelines",
      "params": { "lines": 60, "height": 0.32, "bass": 0.7, "punch": 0.2, "thickness": 1.8, "fill": 0.9, "face": 0.22, "colour": 0, "path": 3, "zoom": 1.0 },
      "bind": { "kick": { "from": "kick.out" }, "glow": { "from": "mid.out", "range": [1.1, 2.3] } } }
  ],
  "edges": [
