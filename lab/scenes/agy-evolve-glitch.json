{
  "format": 1,
  "id": "agy-evolve-glitch",
  "name": "Evolve: glitch",
  "version": 1,
  "author": { "vendor": "agy", "model": "gemini-4-neon-medium" },
  "status": "live",
  "created": "2026-11-27",
  "nodes": [
    { "id": "audio", "piece": "core-audio" },
    { "id": "pal", "piece": "core-swatch", "params": { "colors": "#04070d #0f2a3f #00f5a0 #00d9f5 #ff2a85 #fff275", "cycle": 0.22 } },
    {
      "id": "gen",
      "piece": "agy-matrix",
      "params": { "columns": 68, "speed": 1.3, "trail": 0.74, "density": 0.85, "flare": 1.25, "glitch": 0.45, "glow": 1.3 },
      "bind": { "glow": { "from": "audio.bass", "range": [0.95, 2.1] } }
    },
    {
      "id": "fx",
      "piece": "agy-pixelsort",
      "params": { "direction": 1, "threshold": 0.26, "ceiling": 0.96, "energy": 0.62, "length": 64, "onset_boost": 1.0, "mix": 0.92 }
    }
  ],
  "edges": [
