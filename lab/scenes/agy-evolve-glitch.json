    { "from": "gen.out", "to": "fx.in" }
  ],
  "out": "fx.out",
  "post": { "bloom": 0.55, "threshold": 0.7 },
  "evolve": {
    "every": 2,
    "transition": "random",
    "beats": 1,
    "slots": [
      {
