          { "piece": "claude-fire", "params": { "bass": 0.9, "flare": 1.2, "glow": 1.3 }, "ranges": { "fuel": [0.85, 1.5], "wind": [0.15, 0.75] } },
          { "piece": "codex-grid-floor", "params": { "glow": 1.35 }, "ranges": { "pace": [0.65, 1.6], "horizon": [0.46, 0.6] } },
          "core-scope"
        ]
      },
      {
        "node": "fx",
        "pool": [
          { "piece": "agy-glitch", "params": { "displace": 0.55, "smear": 0.65, "rgb": 0.6, "burst": 0.85 }, "ranges": { "amount": [0.45, 0.85], "blocks": [12, 36] } },
          { "piece": "agy-ascii", "params": { "mode": 0, "color": 0, "contrast": 1.25, "scanlines": 0.2, "mix": 0.95 }, "ranges": { "cell": [8, 18], "bass": [0.4, 1.1] } },
          { "piece": "claude-crt", "params": { "scanlines": 0.5, "curve": 0.35, "vignette": 0.45 }, "ranges": { "chroma": [0.35, 0.85], "tracking": [0.4, 0.85], "jitter": [0.35, 0.75] } },
          { "piece": "claude-slices", "params": { "settle": 0.5, "glitch": 0.45 }, "ranges": { "count": [10, 32], "shift": [0.12, 0.38] } },
          { "piece": "core-pixelate", "ranges": { "cells": [40, 130], "levels": [5, 16] } }
        ]
      },
      {
        "node": "pal",
        "pool": [
          { "piece": "claude-cycle", "params": { "mode": 0, "every": 0, "stride": 2, "flash": 0.15 } },
          { "piece": "core-harmony", "params": { "scheme": 4, "chroma": 0.22, "light": 0.72 }, "ranges": { "hue": [0.0, 1.0] } }
