{
  "format": 1,
  "id": "agy-velvet-vortex",
  "name": "Velvet vortex",
  "version": 1,
  "author": { "vendor": "agy", "model": "gemini-4-neon-high" },
  "status": "live",
  "created": "2026-11-26",
  "nodes": [
    { "id": "aud", "piece": "core-audio" },
    { "id": "bass", "piece": "core-follow", "params": { "lo": 0, "hi": 2, "window": 7, "gain": 1.6 } },
    { "id": "high", "piece": "core-follow", "params": { "lo": 10, "hi": 15, "window": 6, "gain": 1.5 } },
    { "id": "lfo", "piece": "core-lfo", "params": { "beats": 20, "shape": 0 } },
    {
      "id": "pal",
      "piece": "core-harmony",
      "params": { "scheme": 5, "chroma": 0.21, "light": 0.68, "contrast": 0.5 },
      "bind": { "hue": { "from": "lfo.out", "range": [0.72, 1.0] } }
    },
    {
      "id": "sim",
      "piece": "agy-fluid",
      "params": { "vorticity": 2.6, "force": 1.45, "decay": 0.976, "vel_decay": 0.99, "sheen": 1.1, "glow": 1.15 },
      "bind": {
        "force": { "from": "bass.out", "range": [0.95, 2.75] },
        "vorticity": { "from": "bass.out", "range": [1.8, 4.6] },
        "sheen": { "from": "high.out", "range": [0.75, 2.0] },
        "glow": { "from": "aud.rms", "range": [0.95, 1.55] }
      }
    }
  ],
  "edges": [
    { "from": "pal.palette", "to": "sim.palette" }
  ],
  "out": "sim.out",
  "post": { "bloom": 0.7, "threshold": 0.62, "exposure": 1.05 }
}
