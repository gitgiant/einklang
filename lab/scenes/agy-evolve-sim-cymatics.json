{
  "format": 1,
  "id": "agy-evolve-sim-cymatics",
  "name": "Evolve sim: Cymatic Sand",
  "version": 1,
  "author": { "vendor": "agy", "model": "gemini-4-neon-high" },
  "status": "live",
  "created": "2026-11-27",
  "tags": ["media", "evolve", "sim", "chladni", "cymatics", "sand", "waves", "prism"],
  "doc": "Tens of thousands of photo-coloured sand grains vibrate on a resonant Chladni plate driven by your image, video or camera: grains gather along the picture's edge contours and shift into new standing-wave nodal lines as the pitch changes, jolting on onsets and re-forming the picture each phrase while evolving across square Chladni plates, ripple-tank caustics, circular cymatic dishes, chromatic prism lenses and acoustic edge dunes.",
  "nodes": [
    { "id": "bass", "piece": "core-follow", "params": { "lo": 0, "hi": 2, "window": 6, "gain": 1.75 } },
    { "id": "hi", "piece": "core-follow", "params": { "lo": 10, "hi": 15, "window": 5, "gain": 1.9 } },
    {
      "id": "pal",
      "piece": "core-swatch",
      "params": { "colors": "#120c08 #6b3e19 #d99b26 #ffe08a #2ec4b6 #fff8e8", "cycle": 0.22 }
    },
    {
      "id": "media",
      "piece": "core-media",
      "params": { "beat_zoom": 0.26, "pulse": 0.3, "drift": 0.34, "contrast": 1.2, "saturation": 1.18, "edge_width": 2.4 }
    },
    {
      "id": "sim",
      "piece": "agy-cymatic-sand",
      "params": {
        "mode": 0,
        "count": 104,
        "chladni": 1.3,
        "edge_pull": 1.4,
        "luma_warp": 0.4,
        "vibrate": 1.25,
        "jolt": 1.4,
        "reform": 0.72,
        "size": 2.15,
        "streak": 1.55,
        "under": 0.28,
        "pal_mix": 0.4,
        "glow": 1.28,
        "react": 1.45
      },
      "bind": {
        "vibrate": { "from": "bass.out", "range": [0.75, 2.05] },
        "jolt": { "from": "hi.out", "range": [0.85, 2.1] }
      }
    },
    {
      "id": "fx",
      "piece": "codex-neon-phosphor",
      "params": { "cool": "#1f2e78", "warm": "#ff9e2c", "drive": 0.58, "origin": 0.5 },
      "bind": {
        "drive": { "from": "bass.out", "range": [0.35, 0.9] }
      }
    }
  ],
  "edges": [
    { "from": "media.out", "to": "sim.in" },
    { "from": "media.luma", "to": "sim.luma" },
    { "from": "media.edges", "to": "sim.edges" },
    { "from": "pal.palette", "to": "sim.palette" },
    { "from": "sim.out", "to": "fx.in" }
  ],
  "out": "fx.out",
  "post": { "bloom": 0.24, "threshold": 0.82 },
  "evolve": {
    "every": "phrase",
    "transition": "core-dissolve",
    "beats": 2,
    "slots": [
      {
        "node": "sim",
        "pool": [
          {
            "piece": "agy-ripple-optics",
            "params": {
              "mode": 0,
              "cells": 180,
              "speed": 0.95,
              "damp": 0.02,
              "pebble": 1.35,
              "swell": 1.05,
              "edge_wall": 0.68,
              "refract": 1.25,
              "caustic": 1.45,
              "dispersion": 1.15,
              "reform": 0.72,
              "pal_mix": 0.44,
              "glow": 1.18,
              "react": 1.45
            },
            "ranges": { "pebble": [1.0, 1.7], "caustic": [1.1, 1.85] },
            "bind": {
              "refract": { "from": "bass.out", "range": [0.85, 1.95] },
              "dispersion": { "from": "hi.out", "range": [0.6, 2.05] }
            }
          },
          {
            "piece": "agy-cymatic-sand",
            "params": {
              "mode": 1,
              "count": 100,
              "chladni": 1.35,
              "edge_pull": 1.3,
              "luma_warp": 0.38,
              "vibrate": 1.25,
              "jolt": 1.4,
              "reform": 0.74,
              "size": 2.15,
              "streak": 1.6,
              "under": 0.26,
              "pal_mix": 0.44,
              "glow": 1.28,
              "react": 1.45
            },
            "ranges": { "chladni": [1.0, 1.7], "edge_pull": [0.95, 1.65] },
            "bind": {
              "vibrate": { "from": "bass.out", "range": [0.75, 2.0] },
              "jolt": { "from": "hi.out", "range": [0.85, 2.05] }
            }
          },
          {
            "piece": "agy-ripple-optics",
            "params": {
              "mode": 1,
              "cells": 168,
              "speed": 0.9,
              "damp": 0.024,
              "pebble": 1.15,
              "swell": 0.95,
              "edge_wall": 0.65,
              "refract": 1.2,
              "caustic": 1.35,
              "dispersion": 1.5,
              "facets": 6.0,
              "reform": 0.72,
              "pal_mix": 0.45,
              "glow": 1.16,
              "react": 1.45
            },
            "ranges": { "facets": [4.5, 9.0], "refract": [0.95, 1.65] },
            "bind": {
              "dispersion": { "from": "hi.out", "range": [0.85, 2.35] },
              "caustic": { "from": "bass.out", "range": [0.95, 1.95] }
            }
          },
          {
            "piece": "agy-cymatic-sand",
            "params": {
              "mode": 2,
              "count": 100,
              "chladni": 1.2,
              "edge_pull": 1.65,
              "luma_warp": 0.32,
              "vibrate": 1.3,
              "jolt": 1.5,
              "reform": 0.74,
              "size": 2.2,
              "streak": 1.75,
              "under": 0.28,
              "pal_mix": 0.38,
              "glow": 1.28,
              "react": 1.45
            },
            "ranges": { "edge_pull": [1.25, 2.0], "streak": [1.2, 2.3] },
            "bind": {
              "vibrate": { "from": "bass.out", "range": [0.8, 2.05] }
            }
          }
        ]
      }
    ]
  }
}
