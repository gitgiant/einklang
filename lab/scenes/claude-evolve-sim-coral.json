{
  "format": 1, "id": "claude-evolve-sim-coral", "name": "Evolve sim: coral print", "version": 1,
  "author": { "vendor": "claude", "model": "claude-opus-5-5" }, "status": "live", "created": "2026-11-27",
  "tags": ["media", "evolve", "sim", "reaction-diffusion", "organic"],
  "doc": "Reaction-diffusion grown from your picture (image, video or camera): its contours seed the reaction, more on every onset, its bright areas grow coral and its dark ones spots, and the picture shows lit through the embossed pattern; at every phrase start it is wiped back to the bare picture and regrows from the edges. When the song changes section (at least every two phrases) the simulation or the palette swaps: spots that track the light, palette coral in the shadows, the picture stirred as dye by the bass, or a slime mould feeding on it.",
  "nodes": [
    { "id": "lfo", "piece": "core-lfo", "params": { "beats": 64, "shape": 1 } },
    { "id": "pal", "piece": "core-harmony", "params": { "scheme": 2, "chroma": 0.14, "light": 0.72, "contrast": 0.55 },
      "bind": { "hue": { "from": "lfo.out", "range": [0.0, 0.3] } } },
    { "id": "media", "piece": "core-media", "params": { "beat_zoom": 0.08, "pulse": 0.2, "drift": 0.3, "contrast": 1.2, "saturation": 1.1, "edge_width": 2 } },
    { "id": "sim", "piece": "claude-reaction", "params": { "cells": 400, "steps": 12, "regime": 0.45, "luma_map": 0.9, "edge_seed": 0.65, "show": 0.25, "picture": 0.75, "relief": 4, "drift": 0.0008, "swirl": 0.001 } },
    { "id": "fx", "piece": "core-trails", "params": { "decay": 0.15, "zoom": 0, "rotate": 0 } }
  ],
  "edges": [
    { "from": "media.out", "to": "sim.in" },
    { "from": "media.luma", "to": "sim.luma" },
    { "from": "media.edges", "to": "sim.edges" },
    { "from": "pal.palette", "to": "sim.palette" },
    { "from": "sim.out", "to": "fx.in" }
  ],
  "out": "fx.out",
  "post": { "bloom": 0.45, "threshold": 0.75 },
  "evolve": {
    "every": "section", "most": 2, "transition": "random", "beats": 4,
    "slots": [
      { "node": "sim", "pool": [
        { "piece": "claude-reaction", "params": { "cells": 400, "steps": 12, "regime": 0.15, "luma_map": 1.2, "edge_seed": 0.8, "show": 0.3, "picture": 0.9 },
          "ranges": { "relief": [3, 6], "threshold": [0.15, 0.3] } },
        { "piece": "claude-reaction", "params": { "cells": 400, "steps": 12, "regime": 0.7, "luma_map": -0.7, "show": 0.35, "picture": 0.35 },
          "ranges": { "edge_seed": [0.4, 0.8], "swirl": [-0.003, 0.003] } },
        { "piece": "claude-media-dye", "params": { "stir": 1.2, "tint": 0.35, "gloss": 0.9 },
          "ranges": { "along": [-1, 1], "vort": [0.3, 0.8] } },
        { "piece": "claude-media-mould", "params": { "show": 0.25, "tint": 0.35 },
          "ranges": { "food": [1.2, 2.2], "angle": [22, 36] } }
      ] },
      { "node": "pal", "pool": [
        { "piece": "core-swatch", "params": { "colors": "#0d0710 #4a1638 #c8445a #f5a97f #fdf0e0" } },
        { "piece": "core-swatch", "params": { "colors": "#020b14 #0b3a55 #1f8a9e #8be0d0 #f4fff9" } }
      ] }
    ]
  }
}
