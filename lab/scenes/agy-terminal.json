{
  "format": 1,
  "id": "agy-terminal",
  "name": "Phosphor terminal",
  "version": 1,
  "author": { "vendor": "agy", "model": "gemini-4-neon-medium" },
  "status": "live",
  "created": "2026-11-26",
  "nodes": [
    { "id": "hi", "piece": "core-follow", "params": { "lo": 10, "hi": 15, "window": 6, "gain": 1.8 } },
    { "id": "drift", "piece": "core-lfo", "params": { "beats": 16, "shape": 0 } },
    { "id": "pal", "piece": "core-swatch", "params": { "colors": "#04140a #0f5c2e #1fd655 #7dff9b #d4ffe0", "cycle": 0.15 } },
    { "id": "blobs", "piece": "claude-metaballs", "params": { "count": 12, "size": 0.09, "react": 1.3, "speed": 0.9, "pulse": 1.2, "glow": 1.35, "depth": 1.0 } },
    { "id": "scope", "piece": "core-scope" },
    { "id": "mix", "piece": "core-blend", "params": { "mode": 0, "amount": 0.85 } },
    {
      "id": "ascii",
      "piece": "agy-ascii",
      "params": {
        "mode": 2,
        "cell": 14,
        "bass": 0.7,
        "color": 2,
        "levels": 4,
        "contrast": 1.25,
        "bg": "#030b05",
        "scanlines": 0.22
      },
      "bind": {
        "contrast": { "from": "drift.out", "range": [1.05, 1.55] },
        "scanlines": { "from": "hi.out", "range": [0.14, 0.36] }
      }
    }
  ],
  "edges": [
    { "from": "pal.palette", "to": "blobs.palette" },
    { "from": "pal.palette", "to": "ascii.palette" },
    { "from": "blobs.out", "to": "mix.a" },
    { "from": "scope.out", "to": "mix.b" },
    { "from": "mix.out", "to": "ascii.in" }
  ],
  "out": "ascii.out",
  "post": { "bloom": 0.36, "threshold": 0.78 }
}
