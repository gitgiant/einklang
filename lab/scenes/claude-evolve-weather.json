{
  "format": 1, "id": "claude-evolve-weather", "name": "Evolve: weather", "version": 1,
  "author": { "vendor": "claude", "model": "claude-opus-5-5" }, "status": "live", "created": "2026-11-27",
  "doc": "A living sky that changes with the song's sections: a starling murmuration, a storm of lightning, smoke clouds boiling up, a flag in the wind and a slow galaxy at night take turns, under dusk, storm, sunset-blackbody and cold-night palettes.",
  "nodes": [
    { "id": "audio", "piece": "core-audio" },
    { "id": "pal", "piece": "core-harmony", "params": { "hue": 0.08, "scheme": 2, "chroma": 0.15, "light": 0.72, "contrast": 0.6 } },
    { "id": "gen", "piece": "claude-boids", "params": { "count": 16384, "sky": 1.1 } },
    { "id": "trail", "piece": "core-trails", "params": { "decay": 0.6 } }
  ],
  "edges": [
    { "from": "pal.palette", "to": "gen.palette" },
    { "from": "gen.out", "to": "trail.in" }
  ],
  "out": "trail.out",
  "post": { "bloom": 0.5, "threshold": 0.75 },
  "evolve": {
    "every": "section", "most": 2, "transition": "random", "beats": 4,
    "slots": [
      { "node": "gen", "pool": [
        { "piece": "agy-lightning", "params": { "lasers": 0 }, "ranges": { "bolts": [1, 1.8], "haze": [0.5, 1.1] } },
        { "piece": "claude-fluid", "params": { "sources": 4 }, "ranges": { "buoyancy": [0.8, 2], "fade": [2, 4] } },
        { "piece": "claude-cloth", "params": { "pattern": 1 }, "ranges": { "wind": [0.8, 1.6] } },
        { "piece": "claude-nbody", "ranges": { "kick": [0.3, 0.8] } }
      ] },
      { "node": "pal", "jitter": 0.04, "pool": [
        { "piece": "agy-blackbody", "params": { "max_k": 5000, "heat": 4000 }, "ranges": { "min_k": [1100, 1600], "bright": [0.9, 1.1] } },
        { "piece": "core-swatch", "params": { "colors": "#05060f #1b2a4a #4d648f #a9b7cf #ffd27a" } },
        { "piece": "core-swatch", "params": { "colors": "#03020a #120b2e #3b2a6b #8a5fbf #f0c6ff" } },
        { "piece": "core-harmony", "params": { "scheme": 1, "chroma": 0.14, "light": 0.72, "contrast": 0.6 }, "ranges": { "hue": [0.0, 0.15] } }
      ] }
    ]
  }
}
