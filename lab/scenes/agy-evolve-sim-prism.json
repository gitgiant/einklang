      "bind": {
        "dispersion": { "from": "hi.out", "range": [0.85, 2.4] },
        "refract": { "from": "bass.out", "range": [0.85, 1.9] }
      }
    },
    {
      "id": "fx",
      "piece": "core-trails",
      "params": { "decay": 0.44, "zoom": 0.008, "rotate": 0.003 },
      "bind": {
        "zoom": { "from": "bass.out", "range": [0.002, 0.026] }
      }
    }
  ],
  "edges": [
    { "from": "media.out", "to": "sim.in" },
    { "from": "media.luma", "to": "sim.luma" },
    { "from": "media.edges", "to": "sim.edges" },
    { "from": "pal.palette", "to": "sim.palette" },
    { "from": "sim.out", "to": "fx.in" }
  ],
  "out": "fx.out",
  "post": { "bloom": 0.28, "threshold": 0.82 },
