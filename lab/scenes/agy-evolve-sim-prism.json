  "tags": ["media", "evolve", "sim", "prism", "lens", "optics", "caustics", "cymatics"],
  "doc": "Dynamic crystalline lenses and prisms driven by your image, video or camera refract its shapes through live wave ripples and split its light into 7-band spectral rainbows with the highs; onsets spark dispersion caustics, and every phrase the picture snaps back into focus before evolving across chromatic prism lenses, circular cymatic sand dishes, thin-film interferometers, ripple-tank caustics and acoustic sand dunes.",
  "nodes": [
    { "id": "bass", "piece": "core-follow", "params": { "lo": 0, "hi": 2, "window": 6, "gain": 1.75 } },
    { "id": "hi", "piece": "core-follow", "params": { "lo": 10, "hi": 15, "window": 5, "gain": 1.95 } },
    { "id": "lfo", "piece": "core-lfo", "params": { "beats": 64, "shape": 1 } },
    {
      "id": "pal",
      "piece": "core-swatch",
      "params": { "colors": "#13072e #ff006e #ffbe0b #06d6a0 #00bbf9 #ffffff", "cycle": 0.3 }
    },
    {
      "id": "media",
      "piece": "core-media",
      "params": { "beat_zoom": 0.28, "pulse": 0.32, "drift": 0.35, "contrast": 1.18, "saturation": 1.2, "edge_width": 2.4 }
    },
    {
      "id": "sim",
      "piece": "agy-ripple-optics",
      "params": {
        "mode": 1,
        "cells": 172,
        "speed": 0.92,
        "damp": 0.022,
        "pebble": 1.2,
        "swell": 1.0,
        "edge_wall": 0.65,
        "refract": 1.25,
        "caustic": 1.4,
        "dispersion": 1.55,
        "facets": 6.5,
        "reform": 0.74,
        "pal_mix": 0.45,
        "glow": 1.18,
        "react": 1.48
