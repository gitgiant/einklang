{
  "format": 1, "id": "claude-evolve-media-cubefield", "name": "Evolve media: cube field", "version": 1,
  "author": { "vendor": "claude", "model": "claude-opus-5-5" }, "status": "live", "created": "2026-11-27",
  "parent": "claude-media-voxels",
  "tags": ["media", "evolve", "3d", "voxel"],
  "doc": "The cube field of your picture (image, video or camera), and every phrase the picture takes another 3D body and the camera another path: cubes seen from an orbit, a flyover, straight down, a low crane or a spiral; a pin-screen, a point cloud, or ridgelines stood up in rows. Kicks shove the heights up and dolly the camera in, the bass lifts the field, and between the swaps the palette turns.",
  "nodes": [
    { "id": "bass", "piece": "core-follow", "params": { "lo": 0, "hi": 2, "window": 8, "gain": 1.6 } },
    { "id": "mid", "piece": "core-follow", "params": { "lo": 4, "hi": 9, "window": 12, "gain": 1.8 } },
    { "id": "kick", "piece": "core-envelope", "params": { "source": 0, "attack": 0.01, "decay": 0.32, "curve": 3 } },
    { "id": "lfo", "piece": "core-lfo", "params": { "beats": 64, "shape": 1 } },
    { "id": "pal", "piece": "core-harmony", "params": { "scheme": 3, "chroma": 0.19, "light": 0.72, "contrast": 0.5 },
      "bind": { "hue": { "from": "lfo.out", "range": [0.3, 0.8] } } },
    { "id": "media", "piece": "core-media", "params": { "beat_zoom": 0, "pulse": 0.1, "drift": 0.35, "contrast": 1.2, "saturation": 1.2 } },
    { "id": "grid", "piece": "claude-media-cubes",
      "params": { "cells": 44, "height": 4.5, "bass": 0.7, "wave": 3, "gap": 0.1, "tilt": 0.8, "swing": 0.55, "spin": 0.06, "zoom": 1.05, "colour": 0, "edges": 0.9, "path": 0, "punch": 3 },
      "bind": { "edges": { "from": "mid.out", "range": [0.5, 1.8] }, "kick": { "from": "kick.out" } } }
  ],
  "edges": [
    { "from": "media.luma", "to": "grid.height" },
    { "from": "media.out", "to": "grid.in" },
    { "from": "pal.palette", "to": "grid.palette" }
  ],
  "out": "grid.out",
  "post": { "bloom": 0.6, "threshold": 0.65 },
  "evolve": {
    "every": 2, "transition": "claude-cube", "beats": 4,
    "slots": [
      { "node": "grid", "pool": [
        { "piece": "claude-media-cubes", "params": { "colour": 0, "edges": 0.9, "gap": 0.1, "wave": 2.5, "bass": 0.7, "punch": 3 },
          "ranges": { "path": [1, 4], "cells": [32, 56], "height": [3.5, 6], "zoom": [0.9, 1.2] } },
        { "piece": "claude-media-pins", "params": { "shape": 0, "colour": 0, "bass": 0.7, "wave": 1.5, "punch": 2.5 },
          "ranges": { "path": [0, 4], "cells": [40, 60], "height": [3, 5], "size": [0.32, 0.44] },
          "bind": { "glow": { "from": "mid.out", "range": [0.6, 1.8] } } },
        { "piece": "claude-media-pins", "params": { "shape": 1, "colour": 2, "bass": 0.8, "wave": 2, "punch": 3, "size": 0.4 },
          "ranges": { "path": [0, 4], "cells": [52, 76], "height": [3.5, 6] },
          "bind": { "glow": { "from": "mid.out", "range": [0.8, 2.2] } } },
        { "piece": "claude-media-ridgelines", "params": { "colour": 0, "fill": 0.9, "face": 0.22, "punch": 0.2 },
          "ranges": { "path": [0, 4], "lines": [44, 80], "height": [0.25, 0.4] },
          "bind": { "glow": { "from": "mid.out", "range": [1.1, 2.2] } } }
      ] },
      { "node": "pal", "pool": [
        { "piece": "core-swatch", "params": { "colors": "#0b0e1a #2b2d6e #8f5bd6 #f2a7c3 #fff2d6" } },
        { "piece": "core-swatch", "params": { "colors": "#051414 #0f5257 #2a9d8f #e9c46a #fff6da" } },
        { "piece": "core-swatch", "params": { "colors": "#140606 #5a1420 #c8402f #f39a4b #ffe9c2" } }
      ] }
    ]
  }
}
