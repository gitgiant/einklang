{
  "format": 1,
  "id": "claude-wire-flyover",
  "name": "Wireframe flyover",
  "version": 1,
  "author": { "vendor": "claude", "model": "claude-opus-5-5" },
  "status": "live",
  "created": "2026-11-26",
  "nodes": [
    { "id": "clock", "piece": "claude-beat-clock", "params": { "rate": 1 } },
    { "id": "kick", "piece": "core-follow", "params": { "lo": 0, "hi": 2, "window": 4, "gain": 2 } },
    { "id": "pal", "piece": "core-swatch", "params": { "colors": "#03010f #00f6ff #7b2cff #ff00c8 #fff3fb", "cycle": 0 } },
    { "id": "stars", "piece": "claude-starfield", "params": { "horizon": 0.56, "density": 0.14, "drift": 0.04, "size": 1.2, "twinkle": 1.5, "streak": 0.8, "bright": 1.6 } },
    { "id": "moon", "piece": "claude-synth-sun", "params": { "horizon": 0.55, "size": 0.11, "x": 0.5, "rise": 1, "slats": 0, "pulse": 0.3, "glow": 1.2, "sky": 0.45, "bright": 1.3 } },
    { "id": "sky", "piece": "core-blend", "params": { "mode": 0 } },
    { "id": "hills", "piece": "claude-wire-ridges", "params": { "horizon": 0.55, "speed": 2, "rows": 40, "height": 1.5, "valley": 1.1, "audio": 1.4, "sway": 0.7, "tint": 0.25, "fill": 0.08 },
      "bind": { "beats": { "from": "clock.out", "range": [0, 1024] }, "glow": { "from": "kick.out", "range": [1.2, 3] } } },
    { "id": "land", "piece": "core-blend", "params": { "mode": 5 } },
    { "id": "speed", "piece": "core-trails", "params": { "decay": 0.62, "zoom": 0.012, "rotate": 0 } },
    { "id": "crt", "piece": "claude-crt", "params": { "curve": 0.05, "lines": 420, "scan": 0.22, "mask": 0.08, "shift": 0.0012, "kick": 0.006, "track": 0, "noise": 0.015, "vignette": 0.7 } }
  ],
  "edges": [
    { "from": "pal.palette", "to": "stars.palette" },
    { "from": "pal.palette", "to": "moon.palette" },
    { "from": "pal.palette", "to": "hills.palette" },
    { "from": "moon.out", "to": "sky.a" },
    { "from": "stars.out", "to": "sky.b" },
    { "from": "sky.out", "to": "land.a" },
    { "from": "hills.out", "to": "land.b" },
    { "from": "land.out", "to": "speed.in" },
    { "from": "speed.out", "to": "crt.in" }
  ],
  "out": "crt.out",
  "post": { "bloom": 0.9, "threshold": 0.65 }
}
