    { "id": "gen", "piece": "claude-sph", "params": { "count": 6144, "fill": 0.5, "waves": 1.2, "splash": 1.2, "sway": 0.08 } },
    { "id": "fx", "piece": "claude-zoomfeed", "params": { "decay": 0.8, "zoom": 0.004, "bass": 0.015, "pulse": 0.01, "rotate": 0.0, "swing": 0.006, "hue": 0.01 } }
  ],
