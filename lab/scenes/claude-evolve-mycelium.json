{
  "format": 1, "id": "claude-evolve-mycelium", "name": "Evolve: mycelium", "version": 1,
  "author": { "vendor": "claude", "model": "claude-opus-5-5" }, "status": "live", "created": "2026-11-27",
  "doc": "Things that grow: slime-mould veins, Gray-Scott coral, L-system trees, Lenia creatures and Life colonies take turns each phrase, mirrored into a slow mandala, echoed in a feedback bloom, scattered into spores or printed as a halftone plate, in moss and lichen colours.",
  "nodes": [
    { "id": "audio", "piece": "core-audio" },
    { "id": "pal", "piece": "core-harmony", "params": { "hue": 0.32, "scheme": 1, "chroma": 0.15, "light": 0.72, "contrast": 0.6 } },
    { "id": "gen", "piece": "claude-physarum", "params": { "species": 2, "agents": 250 } },
    { "id": "fx", "piece": "core-kaleido", "params": { "segments": 6, "spin": 0.02, "zoom": 1.0 } }
  ],
  "edges": [
    { "from": "pal.palette", "to": "gen.palette" },
    { "from": "gen.out", "to": "fx.in" }
  ],
  "out": "fx.out",
  "post": { "bloom": 0.45, "threshold": 0.75 },
  "evolve": {
    "every": "phrase", "transition": "random", "beats": 4,
    "slots": [
      { "node": "gen", "pool": [
        { "piece": "claude-reaction", "ranges": { "regime": [0.2, 0.9], "swirl": [-0.004, 0.004] } },
        { "piece": "claude-lsystem", "params": { "grammar": 5 }, "ranges": { "trees": [1, 3] } },
        { "piece": "claude-life", "params": { "mode": 1 }, "ranges": { "radius": [6, 11] } },
        { "piece": "claude-life", "params": { "mode": 0, "cells": 135 }, "ranges": { "rate": [2, 4] } },
        { "piece": "claude-physarum", "params": { "species": 1 }, "ranges": { "angle": [20, 45], "reach": [6, 16] } }
      ] },
      { "node": "fx", "pool": [
        { "piece": "claude-zoomfeed", "params": { "decay": 0.82, "zoom": 0.003, "bass": 0.012, "pulse": 0.008, "rotate": 0.002, "swing": 0.006, "hue": 0.015 } },
        { "piece": "claude-dots", "params": { "under": 0.2, "glow": 1.4 }, "ranges": { "cell": [8, 16] } },
        { "piece": "agy-halftone", "params": { "mode": 1, "paper": "#e7e0cc", "ink": "#1f3020", "mix": 0.8 }, "ranges": { "cell": [8, 16] } },
        { "piece": "core-kaleido", "params": { "zoom": 1.15 }, "ranges": { "segments": [3, 10], "spin": [-0.05, 0.05] } }
      ] }
    ]
  }
}
