{
  "format": 1, "id": "core-evolve-circuit", "name": "Evolve: circuit", "version": 1,
  "author": { "vendor": "core", "model": "claude-opus-5-5" }, "status": "live", "created": "2026-11-27",
  "nodes": [
    { "id": "audio", "piece": "core-audio" },
    { "id": "pal", "piece": "core-swatch", "params": { "colors": "#0d0221 #261447 #ff3864 #2de2e6 #f6019d #fdfdfd", "cycle": 0.2 } },
    { "id": "gen", "piece": "codex-grid-floor", "params": { "pace": 0.9 },
      "bind": { "glow": { "from": "audio.bass", "range": [0.9, 2.0] } } },
    { "id": "fx", "piece": "claude-crt", "params": { "scanlines": 0.45, "curve": 0.35, "chroma": 0.4, "tracking": 0.4, "jitter": 0.3 } }
  ],
  "edges": [
    { "from": "pal.palette", "to": "gen.palette" },
    { "from": "gen.out", "to": "fx.in" }
  ],
  "out": "fx.out",
  "post": { "bloom": 0.55, "threshold": 0.7 },
  "evolve": {
    "every": "section", "most": 2, "transition": "random", "beats": 2,
    "slots": [
      { "node": "gen", "filter": { "tags": ["synthwave", "space", "terrain"] }, "max": 5 },
      { "node": "fx", "filter": { "tags": ["retro", "glitch"] }, "jitter": 0.12 }
    ]
  }
}
