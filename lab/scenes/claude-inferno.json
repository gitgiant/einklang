{
  "format": 1, "id": "claude-inferno", "name": "Inferno", "version": 1,
  "author": { "vendor": "claude", "model": "claude-sonnet-5-5" },
  "status": "live", "created": "2026-11-26",
  "nodes": [
    { "id": "gust", "piece": "core-lfo", "params": { "beats": 32, "shape": 0 } },
    { "id": "low", "piece": "core-follow", "params": { "lo": 0, "hi": 3, "window": 12, "gain": 1.6 } },
    { "id": "pal", "piece": "core-swatch", "params": { "colors": "#000000 #1f0208 #6a0510 #c81e04 #ff6a00 #ffb81f #fff3b0", "cycle": 0, "pads": false } },
    { "id": "fire", "piece": "claude-fire", "params": { "cells": 270, "steps": 2, "fuel": 1, "bass": 0.8, "flare": 1.1, "cooling": 3.8, "glow": 1.25 },
      "bind": { "wind": { "from": "gust.out", "range": [0.3, 0.7] } } },
    { "id": "heat", "piece": "core-trails", "params": { "decay": 0.45, "rotate": 0 }, "bind": { "zoom": { "from": "low.out", "range": [0, 0.012] } } }
  ],
  "edges": [ { "from": "pal.palette", "to": "fire.palette" }, { "from": "fire.out", "to": "heat.in" } ],
  "out": "heat.out",
  "post": { "bloom": 0.55, "threshold": 0.75 }
}
