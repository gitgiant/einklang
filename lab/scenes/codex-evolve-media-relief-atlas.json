{
  "format": 1,
  "id": "codex-evolve-media-relief-atlas",
  "name": "Relief Atlas",
  "doc": "Luma lifts the picked picture into contour ridges, a flyover, a tunnel, or stacked blocks. The relief takes a screen print or phosphor finish as the music moves between sections.",
  "version": 2,
  "author": { "vendor": "codex", "model": "gpt-6.2-sol" },
  "status": "live",
  "created": "2026-11-27",
  "tags": ["media", "evolve", "contours", "neon"],
  "nodes": [
    { "id": "level", "piece": "core-follow", "params": { "lo": 0, "hi": 5, "window": 16, "gain": 2.8 } },
    { "id": "media", "piece": "core-media",
      "params": { "contrast": 1.08, "saturation": 1.06, "beat_zoom": 0.25, "pulse": 0.36, "drift": 0.48, "cycle": 0 },
      "bind": { "brightness": { "from": "level.out", "range": [0.63, 1.55] } } },
    { "id": "ink", "piece": "core-swatch", "params": { "colors": "#17102c #55309f #16d4db #fa67a6 #fbe1b8", "pads": false } },
    { "id": "relief", "piece": "claude-ridges", "params": { "lines": 64, "height": 0.17, "bass": 0.78, "colour": 1, "fill": 0.78, "glow": 1.22 } },
    { "id": "screen", "piece": "agy-halftone", "params": { "cell": 13, "mix": 0.45, "paper": "#ffe3cd", "ink": "#281c55" } }
  ],
  "edges": [
    { "from": "media.luma", "to": "relief.height" },
    { "from": "media.out", "to": "relief.in" },
    { "from": "ink.palette", "to": "relief.palette" },
    { "from": "relief.out", "to": "screen.in" }
  ],
  "out": "screen.out",
  "post": { "bloom": 0.29, "threshold": 0.75, "exposure": 0.94 },
  "evolve": {
    "every": "section", "most": 2, "transition": "core-blend", "beats": 2,
    "slots": [
      { "node": "relief", "jitter": 0, "pool": [
        { "piece": "claude-media-tunnel", "params": { "sides": 8, "relief": 0.47, "speed": 1.2, "colour": 2, "rings": 0.8 } },
        { "piece": "claude-media-cubes", "params": { "cells": 32, "height": 3, "bass": 0.75, "colour": 2, "edges": 0.62 } },
        { "piece": "claude-luma-terrain", "params": { "height": 0.82, "pitch": 0.32, "speed": 1.35, "colour": 2, "contour": 1.02 } }
      ] },
      { "node": "screen", "jitter": 0, "pool": [
        { "piece": "claude-dots", "params": { "cell": 12, "jitter": 0.27, "glow": 1.14, "under": 0.48 } },
        { "piece": "codex-neon-phosphor", "params": { "cool": "#187cce", "warm": "#fa3f9b", "drive": 0.7 } }
      ] },
      { "node": "ink", "jitter": 0, "pool": [
        { "piece": "core-harmony", "params": { "hue": 0.47, "scheme": 2, "chroma": 0.17, "light": 0.7, "pads": false } }
      ] }
    ]
  }
}
