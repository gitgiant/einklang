{
  "format": 1,
  "id": "agy-evolve-media-matrix",
  "name": "Evolve media: Matrix Remix",
  "parent": "agy-media-matrix",
  "version": 1,
  "author": { "vendor": "agy", "model": "gemini-4-neon-high" },
  "status": "live",
  "created": "2026-11-27",
  "tags": ["media", "evolve", "matrix", "rain", "ascii", "glitch", "terminal"],
  "doc": "Evolving remix of Media: Matrix Code without legacy trails: your photo, video or camera cascades as code rain, ASCII/Braille phosphor terminal or slit-scan code ribbons, swapping glyph treatment, density, onset glitch finish and phosphor palettes every phrase.",
  "nodes": [
    { "id": "bass", "piece": "core-follow", "params": { "lo": 0, "hi": 2, "window": 6, "gain": 1.6 } },
    { "id": "mid", "piece": "core-follow", "params": { "lo": 4, "hi": 10, "window": 6, "gain": 1.75 } },
    { "id": "hi", "piece": "core-follow", "params": { "lo": 10, "hi": 15, "window": 5, "gain": 1.85 } },
    {
      "id": "pal",
      "piece": "core-swatch",
      "params": { "colors": "#020b05 #0a3b1e #00e676 #38ff9c #d8fff0", "cycle": 0.18 }
    },
    {
      "id": "media",
      "piece": "core-media",
      "params": { "beat_zoom": 0.34, "pulse": 0.34, "drift": 0.45, "contrast": 1.25, "saturation": 1.2, "edge_width": 2.5 }
    },
    {
      "id": "rain",
      "piece": "agy-media-rain",
      "params": { "columns": 76, "speed": 1.15, "trail": 0.74, "color_mix": 0.48, "edge_boost": 1.1, "glitch": 0.5, "glow": 1.28, "scanlines": 0.16 },
      "bind": {
        "glow": { "from": "bass.out", "range": [0.95, 1.95] },
        "glitch": { "from": "mid.out", "range": [0.2, 0.95] }
      }
    },
    {
      "id": "fx",
      "piece": "agy-glitch",
      "params": { "amount": 0.4, "displace": 0.4, "smear": 0.46, "rgb": 0.48, "burst": 0.88, "blocks": 22 },
      "bind": {
        "displace": { "from": "bass.out", "range": [0.16, 0.7] },
        "rgb": { "from": "hi.out", "range": [0.22, 0.86] }
      }
    }
  ],
  "edges": [
    { "from": "media.out", "to": "rain.in" },
    { "from": "media.luma", "to": "rain.luma" },
    { "from": "media.edges", "to": "rain.edges" },
    { "from": "pal.palette", "to": "rain.palette" },
    { "from": "rain.out", "to": "fx.in" }
  ],
  "out": "fx.out",
  "post": { "bloom": 0.46, "threshold": 0.72 },
  "evolve": {
    "every": "phrase",
    "transition": "core-glitch",
    "beats": 2,
    "slots": [
      {
        "node": "rain",
        "pool": [
          {
            "piece": "agy-media-rain",
            "params": { "edge_boost": 1.0, "scanlines": 0.14 },
            "ranges": { "columns": [98, 134], "speed": [1.35, 2.2], "trail": [0.68, 0.92], "color_mix": [0.62, 0.86] }
          },
          {
            "piece": "agy-media-rain",
            "params": { "scanlines": 0.2 },
            "ranges": { "columns": [42, 60], "speed": [0.75, 1.3], "trail": [0.62, 0.84], "color_mix": [0.18, 0.42], "edge_boost": [1.25, 2.0] }
          },
          {
            "piece": "agy-media-terminal",
            "params": { "charset": 0, "scan_beam": 0.85, "scanlines": 0.22 },
            "ranges": { "cell": [10, 18], "color_mix": [0.26, 0.56], "edge_lock": [1.0, 1.8] },
            "bind": {
              "glow": { "from": "bass.out", "range": [1.0, 1.88] },
              "glitch": { "from": "mid.out", "range": [0.32, 1.12] }
            }
          },
          {
            "piece": "agy-media-terminal",
            "params": { "charset": 1, "scan_beam": 0.78, "scanlines": 0.2 },
            "ranges": { "cell": [9, 16], "color_mix": [0.38, 0.68], "edge_lock": [0.9, 1.6] },
            "bind": {
              "glow": { "from": "bass.out", "range": [1.0, 1.88] },
              "glitch": { "from": "mid.out", "range": [0.32, 1.12] }
            }
          },
          {
            "piece": "agy-slit-code",
            "params": { "axis": 0, "slit": 0.16, "glyph_mix": 0.82, "edge_warp": 0.52, "decay": 0.92 },
            "ranges": { "cell": [10, 18], "tear": [0.45, 0.95] },
            "bind": {
              "drift": { "from": "bass.out", "range": [0.24, 0.82] },
              "rgb": { "from": "hi.out", "range": [0.28, 1.0] }
            }
          }
        ]
      },
      {
        "node": "fx",
        "pool": [
          {
            "piece": "agy-ascii",
            "params": { "mode": 2, "color": 0, "contrast": 1.18, "scanlines": 0.2 },
            "ranges": { "cell": [9, 17], "bass": [0.35, 0.95], "mix": [0.55, 0.82] }
          },
          {
            "piece": "claude-crt",
            "params": { "scanlines": 0.44, "curve": 0.3, "vignette": 0.36 },
            "ranges": { "chroma": [0.32, 0.82], "tracking": [0.35, 0.82], "jitter": [0.25, 0.65] }
          },
          {
            "piece": "claude-slices",
            "params": { "dir": 0, "settle": 0.45 },
            "ranges": { "count": [10, 26], "shift": [0.12, 0.32], "glitch": [0.38, 0.82] }
          },
          {
            "piece": "agy-pixelsort",
            "params": { "direction": 1, "threshold": 0.32, "ceiling": 0.95, "energy": 0.6, "onset_boost": 0.95 },
            "ranges": { "length": [36, 86], "mix": [0.58, 0.84] }
          }
        ]
      },
      {
        "node": "pal",
        "pool": [
          { "piece": "core-swatch", "params": { "colors": "#120802 #4f2304 #ff8c00 #ffd166 #fff6d9", "cycle": 0.22 } },
          { "piece": "core-swatch", "params": { "colors": "#0a0414 #241047 #00d9f5 #ff2a85 #fff275", "cycle": 0.28 } },
          { "piece": "core-swatch", "params": { "colors": "#030916 #0b2d5c #1ea7ff #7ce8ff #eefaff", "cycle": 0.2 } },
          { "piece": "core-harmony", "params": { "scheme": 4, "chroma": 0.22, "light": 0.72 }, "ranges": { "hue": [0.0, 1.0] } }
        ]
      }
    ]
  }
}
