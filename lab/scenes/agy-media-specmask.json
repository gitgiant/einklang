{
  "format": 1,
  "id": "agy-media-specmask",
  "name": "Media: Spectral Mask",
  "version": 1,
  "author": { "vendor": "agy", "model": "gemini-4-neon-medium" },
  "status": "live",
  "created": "2026-11-27",
  "tags": ["media", "spectrogram", "pianoroll", "mask", "glitch"],
  "nodes": [
    { "id": "bass", "piece": "core-follow", "params": { "lo": 0, "hi": 2, "window": 6, "gain": 1.65 } },
    { "id": "hi", "piece": "core-follow", "params": { "lo": 10, "hi": 15, "window": 5, "gain": 1.9 } },
    { "id": "pal", "piece": "core-swatch", "params": { "colors": "#08071a #1e2a78 #00e5ff #ff3366 #ffe066", "cycle": 0.3 } },
    {
      "id": "media",
      "piece": "core-media",
      "params": { "beat_zoom": 0.36, "pulse": 0.32, "drift": 0.45, "contrast": 1.2, "saturation": 1.2, "edge_width": 2.5 }
    },
    {
      "id": "spec",
      "piece": "agy-spectrogram",
      "params": { "direction": 0, "speed": 1.8, "freq_scale": 0, "gain": 1.6, "gamma": 1.15, "pal_mode": 0, "mirror": true, "onset_mark": 0.85, "tilt": 0.0, "glow": 1.65 }
    },
    {
      "id": "mask",
      "piece": "agy-data-mask",
      "params": { "threshold": 0.22, "soft": 0.18, "ghost": 0.28, "data_glow": 0.7, "edge_glow": 1.0, "rgb_split": 0.55, "block_glitch": 0.48, "invert": false },
      "bind": {
        "rgb_split": { "from": "hi.out", "range": [0.22, 1.15] },
        "block_glitch": { "from": "bass.out", "range": [0.15, 0.95] }
      }
    },
    {
      "id": "trails",
      "piece": "core-trails",
      "params": { "decay": 0.44, "zoom": 0.002, "rotate": 0 }
    }
  ],
  "edges": [
    { "from": "pal.palette", "to": "spec.palette" },
    { "from": "pal.palette", "to": "mask.palette" },
    { "from": "media.out", "to": "mask.in" },
    { "from": "spec.out", "to": "mask.data" },
    { "from": "media.edges", "to": "mask.edges" },
    { "from": "mask.out", "to": "trails.in" }
  ],
  "out": "trails.out",
  "post": { "bloom": 0.48, "threshold": 0.7 },
  "sections": {
    "on": "phrase",
    "transition": "core-wipe",
    "beats": 2,
    "variants": [
      {
        "id": "drop",
        "when": { "section": "drop" },
        "transition": "core-glitch",
        "beats": 1,
        "nodes": [
          {
            "id": "spec",
            "piece": "agy-pianoroll",
            "params": { "speed": 2.0, "gain": 1.65, "threshold": 0.18, "perspective": 0.34, "keyboard_h": 0.18, "glow": 1.8, "grid": 0.4 }
          }
        ],
        "params": {
          "mask": { "threshold": 0.18, "soft": 0.14, "ghost": 0.24, "data_glow": 0.85, "edge_glow": 1.2 }
        },
        "post": { "bloom": 0.56, "threshold": 0.66 }
      },
      {
        "id": "breakdown",
        "when": { "section": "breakdown" },
        "transition": "core-blend",
        "beats": 4,
        "params": {
          "spec": { "direction": 3, "speed": 1.1, "tilt": 0.52, "mirror": false, "gain": 1.45, "glow": 1.45 },
          "mask": { "threshold": 0.24, "soft": 0.22, "ghost": 0.36, "data_glow": 0.55, "edge_glow": 0.85 }
        },
        "post": { "bloom": 0.42, "threshold": 0.74 }
      }
    ]
  }
}
