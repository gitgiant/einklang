{
  "format": 1,
  "id": "claude-outrun-drive",
  "name": "Outrun drive",
  "version": 1,
  "author": { "vendor": "claude", "model": "claude-opus-5-5" },
  "status": "live",
  "created": "2026-11-26",
  "nodes": [
    { "id": "clock", "piece": "claude-beat-clock", "params": { "rate": 1, "sharp": 5 } },
    { "id": "kick", "piece": "core-follow", "params": { "lo": 0, "hi": 2, "window": 4, "gain": 2 } },
    { "id": "pal", "piece": "core-swatch", "params": { "colors": "#120458 #5b0a91 #ff2a6d #ff9e3d #fff275", "cycle": 0 } },
    { "id": "stars", "piece": "claude-starfield", "params": { "horizon": 0.58, "density": 0.12, "drift": 0.015, "streak": 0.4, "bright": 1.4 } },
    { "id": "sun", "piece": "claude-synth-sun", "params": { "horizon": 0.58, "size": 0.24, "rise": 0.62, "slats": 9, "scroll": 0.5, "pulse": 0.2, "glow": 0.9, "bright": 1.1 },
      "bind": { "beats": { "from": "clock.out", "range": [0, 1024] } } },
    { "id": "sky", "piece": "core-blend", "params": { "mode": 0 } },
    { "id": "road", "piece": "claude-neon-grid", "params": { "horizon": 0.58, "mode": 2, "speed": 2, "height": 0.4, "road": 1.0, "curve": 0.7, "tint": 0.5, "glow": 2.2, "wave": 1.2, "fog": 0.06, "reflect": 0.25 },
      "bind": { "beats": { "from": "clock.out", "range": [0, 1024] }, "pulse": { "from": "kick.out", "range": [0.3, 1.5] } } },
    { "id": "floor", "piece": "core-blend", "params": { "mode": 5 } },
    { "id": "title", "piece": "core-text", "params": { "source": 0, "text": "OUTRUN", "font": 1, "mode": 0, "size": 0.18, "y": 0.2, "glow": 1, "upper": true } },
    { "id": "chrome", "piece": "claude-chrome", "params": { "y": 0.2, "height": 0.15, "sweep": 0.25, "outline": 0.005, "neon": 1.6, "tint": 0.5, "bright": 1.3 },
      "bind": { "beats": { "from": "clock.out", "range": [0, 1024] } } },
    { "id": "logo", "piece": "core-blend", "params": { "mode": 5 } },
    { "id": "crt", "piece": "claude-crt", "params": { "curve": 0.08, "lines": 360, "scan": 0.3, "mask": 0.12, "shift": 0.001, "kick": 0.004, "track": 0.15, "noise": 0.015, "vignette": 0.6 } }
  ],
  "edges": [
    { "from": "pal.palette", "to": "stars.palette" },
    { "from": "pal.palette", "to": "sun.palette" },
    { "from": "pal.palette", "to": "road.palette" },
    { "from": "pal.palette", "to": "title.palette" },
    { "from": "pal.palette", "to": "chrome.palette" },
    { "from": "sun.out", "to": "sky.a" },
    { "from": "stars.out", "to": "sky.b" },
    { "from": "sky.out", "to": "road.sky" },
    { "from": "sky.out", "to": "floor.a" },
    { "from": "road.out", "to": "floor.b" },
    { "from": "title.out", "to": "chrome.in" },
    { "from": "floor.out", "to": "logo.a" },
    { "from": "chrome.out", "to": "logo.b" },
    { "from": "logo.out", "to": "crt.in" }
  ],
  "out": "crt.out",
  "post": { "bloom": 0.6, "threshold": 0.75 }
}
