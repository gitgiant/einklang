{
  "format": 1,
  "id": "claude-media-smoke",
  "name": "Media: picture smoke",
  "version": 2,
  "author": { "vendor": "claude", "model": "claude-opus-5-5" },
  "status": "live",
  "created": "2026-11-27",
  "tags": ["media", "fluid", "smoke", "simulation"],
  "nodes": [
    { "id": "lfo", "piece": "core-lfo", "params": { "beats": 64, "shape": 1 } },
    { "id": "pal", "piece": "core-harmony", "params": { "scheme": 4, "chroma": 0.16, "light": 0.72, "contrast": 0.5 },
      "bind": { "hue": { "from": "lfo.out", "range": [0.0, 0.4] } } },
    { "id": "media", "piece": "core-media", "params": { "beat_zoom": 0.2, "pulse": 0.3, "drift": 0.35, "contrast": 1.1, "saturation": 1.1 } },
    { "id": "smoke", "piece": "claude-picture-smoke",
      "params": { "restore": 1.0, "snap": 1.2, "swirls": 3, "size": 0.24, "spin": 1.3, "breath": 1.6, "burst": 1.1, "buoyancy": 1.0, "sheen": 0.35, "flash": 0.35 } }
  ],
  "edges": [
    { "from": "media.out", "to": "smoke.in" },
    { "from": "media.luma", "to": "smoke.luma" },
    { "from": "pal.palette", "to": "smoke.palette" }
  ],
  "out": "smoke.out",
  "post": { "bloom": 0.45, "threshold": 0.7 },
  "sections": {
    "on": "phrase",
    "transition": "core-blend", "beats": 2,
    "variants": [
      { "id": "drop", "when": { "section": "drop" }, "transition": "core-flash", "beats": 1,
        "params": { "smoke": { "swirls": 4, "spin": 1.8, "breath": 2.2, "burst": 1.2, "restore": 0.8, "snap": 1.6, "vorticity": 1.4, "sheen": 0.5, "saturation": 1.4, "flash": 0.5 },
                    "media": { "beat_zoom": 0.3, "pulse": 0.4 } },
        "post": { "bloom": 0.75 } },
      { "id": "build", "when": { "section": "build" },
        "params": { "smoke": { "swirls": 4, "spin": 1.4, "size": 0.18, "breath": 1.4, "vorticity": 1.4 } } },
      { "id": "breakdown", "when": { "section": "breakdown" }, "transition": "core-dissolve", "beats": 4,
        "params": { "smoke": { "swirls": 2, "spin": 0.5, "idle": 0.5, "memory": 1.6, "buoyancy": 2.4, "restore": 2.2, "snap": 0.4, "burst": 0.3, "sheen": 0.15 } } }
    ]
  }
}
