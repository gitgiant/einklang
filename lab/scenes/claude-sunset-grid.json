{
  "format": 1,
  "id": "claude-sunset-grid",
  "name": "Sunset grid",
  "version": 1,
  "author": { "vendor": "claude", "model": "claude-opus-5-5" },
  "status": "live",
  "created": "2026-11-26",
  "nodes": [
    { "id": "clock", "piece": "claude-beat-clock", "params": { "rate": 1, "sharp": 4 } },
    { "id": "kick", "piece": "core-follow", "params": { "lo": 0, "hi": 3, "window": 6, "gain": 2.2 } },
    { "id": "pal", "piece": "core-swatch", "params": { "colors": "#0b0226 #00e5ff #6b1fa8 #ff2e88 #ff7b2e #ffe14a", "cycle": 0 } },
    { "id": "sun", "piece": "claude-synth-sun", "params": { "horizon": 0.6, "size": 0.28, "rise": 0.7, "slats": 12, "scroll": 0.25, "pulse": 0.15, "bright": 1.7 },
      "bind": { "beats": { "from": "clock.out", "range": [0, 1024] }, "glow": { "from": "kick.out", "range": [0.5, 2.4] } } },
    { "id": "grid", "piece": "claude-neon-grid", "params": { "horizon": 0.6, "mode": 0, "speed": 1, "height": 0.42, "cell": 1, "curve": 0, "tint": 0.2, "glow": 1.5, "pulse": 1, "wave": 1.6, "fog": 0.1, "reflect": 1.1 },
      "bind": { "beats": { "from": "clock.out", "range": [0, 1024] } } },
    { "id": "floor", "piece": "core-blend", "params": { "mode": 5 } },
    { "id": "crt", "piece": "claude-crt", "params": { "curve": 0.16, "lines": 300, "scan": 0.45, "mask": 0.22, "shift": 0.0008, "kick": 0.003, "track": 0, "noise": 0.02, "vignette": 0.8 } }
  ],
  "edges": [
    { "from": "pal.palette", "to": "sun.palette" },
    { "from": "pal.palette", "to": "grid.palette" },
    { "from": "sun.out", "to": "grid.sky" },
    { "from": "sun.out", "to": "floor.a" },
    { "from": "grid.out", "to": "floor.b" },
    { "from": "floor.out", "to": "crt.in" }
  ],
  "out": "crt.out",
  "post": { "decay": 0.5, "zoom": 0.002, "bloom": 0.8, "threshold": 0.7 }
}
