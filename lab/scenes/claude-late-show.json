{
  "format": 1, "id": "claude-late-show", "name": "Late show", "version": 1,
  "author": { "vendor": "claude", "model": "claude-sonnet-5-5" },
  "status": "live", "created": "2026-11-26",
  "nodes": [
    { "id": "level", "piece": "core-follow", "params": { "lo": 0, "hi": 3, "window": 6, "gain": 1.6 } },
    { "id": "pal", "piece": "core-swatch", "params": { "colors": "#1b2a8f #00c2d1 #ffd23f #ff5a36 #e0218a", "cycle": 0.25 } },
    { "id": "sky", "piece": "core-plasma", "params": { "scale": 1.6, "speed": 0.25, "gain": 0.1 }, "bind": { "warp": { "from": "level.out", "range": [0.1, 1.2] } } },
    { "id": "bars", "piece": "core-bars", "params": { "height": 0.5, "gap": 0.25, "glow": 1.1 } },
    { "id": "title", "piece": "core-text", "params": { "source": 0, "text": "LATE SHOW", "font": 0, "mode": 1, "size": 0.2, "y": 0.28, "kick": 0.25, "glow": 1.3 } },
    { "id": "m1", "piece": "core-blend", "params": { "mode": 0 } },
