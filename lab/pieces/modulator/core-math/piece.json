{
  "id": "core-math", "kind": "modulator", "name": "Math",
  "doc": "Signal math: map a's in_lo..in_hi onto lo..hi, clamp, mix a and b by amount, add, multiply, min, max, invert, threshold (1 above amount), or quantize to `steps` levels. The result is clamped to lo..hi.",
  "ports": {
    "in": { "a": { "type": "signal" }, "b": { "type": "signal", "optional": true } },
    "out": { "out": { "type": "signal" } }
  },
  "params": {
    "op": { "type": "enum", "default": 0, "options": ["map", "mix", "add", "multiply", "min", "max", "invert", "threshold", "quantize"] },
    "in_lo": { "type": "float", "default": 0, "min": -4, "max": 4, "doc": "map: a at this reads as 0" },
    "in_hi": { "type": "float", "default": 1, "min": -4, "max": 4, "doc": "map: a at this reads as 1" },
    "lo": { "type": "float", "default": 0, "min": -4, "max": 4, "doc": "output for 0" },
    "hi": { "type": "float", "default": 1, "min": -4, "max": 4, "doc": "output for 1" },
    "amount": { "type": "float", "default": 0.5, "min": 0, "max": 1, "doc": "mix: b's share; threshold: the level" },
    "steps": { "type": "int", "default": 4, "min": 2, "max": 32, "doc": "quantize: levels" }
  },
  "tags": ["math", "map", "clamp", "core"], "author": { "vendor": "core", "model": "claude-opus-5-5" }
}
