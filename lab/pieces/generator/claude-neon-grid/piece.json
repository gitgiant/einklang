{
  "id": "claude-neon-grid", "kind": "generator", "name": "Neon grid floor",
  "doc": "Perspective floor below the horizon that scrolls toward the camera one cell per beat: glowing neon lines, a vaporwave checkerboard, or an outrun road with edge lines and centre dashes, bending left and right. A light pulse runs toward the viewer on every beat, bass brightens the lines, and an optional sky input is mirrored on the wet floor. Transparent above the horizon (premultiplied: blend with 'over').",
  "ports": {
    "in": { "palette": { "type": "palette", "optional": true }, "sky": { "type": "tex", "optional": true, "doc": "reflected on the floor" } },
    "out": { "out": { "type": "tex" } }
  },
  "params": {
    "horizon": { "type": "float", "default": 0.62, "min": 0.2, "max": 0.95 },
    "mode": { "type": "enum", "default": 0, "options": ["lines", "checker", "road"] },
    "beats": { "type": "float", "default": 0, "min": 0, "max": 1024, "doc": "bind to claude-beat-clock.out, range [0, 1024]" },
    "speed": { "type": "float", "default": 1, "min": -4, "max": 4, "doc": "cells per beat" },
    "height": { "type": "float", "default": 0.35, "min": 0.05, "max": 2, "doc": "camera height in cells" },
    "cell": { "type": "float", "default": 1, "min": 0.25, "max": 4 },
    "road": { "type": "float", "default": 1.6, "min": 0.3, "max": 4, "doc": "road half-width in cells (mode road)" },
    "curve": { "type": "float", "default": 0.4, "min": 0, "max": 2, "doc": "how far the floor bends side to side" },
    "tint": { "type": "float", "default": 0.6, "min": 0, "max": 1, "doc": "palette position of the lines / light tiles" },
    "glow": { "type": "float", "default": 1.6, "min": 0, "max": 6 },
    "pulse": { "type": "float", "default": 0.8, "min": 0, "max": 3, "doc": "bass brightening" },
    "wave": { "type": "float", "default": 1, "min": 0, "max": 4, "doc": "the light pulse that runs toward the camera each beat" },
    "fog": { "type": "float", "default": 0.12, "min": 0, "max": 1 },
    "reflect": { "type": "float", "default": 0.5, "min": 0, "max": 1.5, "doc": "mirror of the sky input" }
  },
  "shader": "grid.wgsl", "budget": { "ms": 0.3, "scales": "res" },
  "tags": ["synthwave", "outrun", "vaporwave", "grid", "floor", "road", "retro"],
  "author": { "vendor": "claude", "model": "claude-opus-5-5" },
  "changelog": [{ "date": "2026-11-26", "by": "claude-opus-5-5", "note": "first version (vaporwave/synthwave batch)" }]
}
