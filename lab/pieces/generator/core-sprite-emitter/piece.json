{
  "id": "core-sprite-emitter",
  "kind": "generator",
  "name": "Sprite emitter",
  "doc": "Sprites as particles: every onset throws a burst from the origin, plus a steady trickle. Closed-form (each sprite's path is a function of the tick it was born on), so it needs no state and every host agrees.",
  "ports": {
    "in": { "palette": { "type": "palette", "optional": true, "doc": "tints the sprites" } },
    "out": { "out": { "type": "tex" } }
  },
  "params": {
    "sheet": { "type": "enum", "default": 1, "options": ["dancer", "sparkle", "heart", "note"] },
    "burst": { "type": "int", "default": 12, "min": 0, "max": 64, "doc": "sprites per onset" },
    "trickle": { "type": "float", "default": 4, "min": 0, "max": 40, "doc": "sprites per second regardless of onsets" },
    "speed": { "type": "float", "default": 0.6, "min": 0, "max": 3, "doc": "screen heights per second" },
    "gravity": { "type": "float", "default": 0.6, "min": -2, "max": 2 },
    "spread": { "type": "float", "default": 1, "min": 0, "max": 1, "doc": "0 = straight up, 1 = all directions" },
    "life": { "type": "float", "default": 2, "min": 0.2, "max": 8, "doc": "seconds" },
    "size": { "type": "float", "default": 0.06, "min": 0.01, "max": 0.3, "doc": "screen heights" },
    "x": { "type": "float", "default": 0.5, "min": 0, "max": 1 },
    "y": { "type": "float", "default": 0.55, "min": 0, "max": 1 },
    "tint": { "type": "float", "default": 0.5, "min": 0, "max": 1 },
    "glow": { "type": "float", "default": 1.5, "min": 0, "max": 4 }
  },
  "assets": [
    { "path": "assets/sprites/dancer.spr", "license": "own", "source": "code-drawn" },
    { "path": "assets/sprites/sparkle.spr", "license": "own", "source": "code-drawn" },
    { "path": "assets/sprites/heart.spr", "license": "own", "source": "code-drawn" },
    { "path": "assets/sprites/note.spr", "license": "own", "source": "code-drawn" }
  ],
  "budget": { "ms": 0.5, "scales": "n" },
  "tags": ["sprite", "particles", "pixel", "core"],
  "author": { "vendor": "core", "model": "claude-opus-5-5" },
  "changelog": [{ "date": "2026-11-26", "by": "claude-opus-5-5", "note": "first version (#26)" }]
}
