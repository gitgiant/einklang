{
  "id": "claude-cloth",
  "kind": "generator",
  "name": "Cloth",
  "doc": "A pinned cloth (a verlet particle grid with structural, shear and bend constraints relaxed on the GPU) flying from a pole, hanging from a bar or held by two corners, billowing in a turbulent wind, and drawn as a shaded two-sided satin mesh with a palette pattern over a dusk gradient. The bass sets the wind strength, the mids swing its direction, the highs add flutter, and each onset sends a gust and a flash; the spectrum pattern shows the live bands on the cloth.",
  "ports": {
    "in": { "palette": { "type": "palette", "optional": true, "doc": "the darkest stops paint the sky; the pattern (stripes, spectrum, chevrons, gradient) takes the upper stops" } },
    "out": { "out": { "type": "tex" } }
  },
  "params": {
    "cols": { "type": "int", "default": 72, "min": 8, "max": 160, "doc": "particles along the width" },
    "rows": { "type": "int", "default": 46, "min": 6, "max": 120, "doc": "particles along the height" },
    "pin": { "type": "enum", "default": 0, "options": ["pole", "top", "corners"], "doc": "how it hangs: a flag on a pole, a banner from a bar, a sheet by two corners" },
    "steps": { "type": "int", "default": 3, "min": 1, "max": 6, "doc": "substeps per tick" },
    "iters": { "type": "int", "default": 15, "min": 1, "max": 41, "doc": "constraint passes per substep (made odd)" },
    "stiffness": { "type": "float", "default": 1, "min": 0.3, "max": 1.8, "doc": "constraint relaxation: higher stretches less" },
    "damping": { "type": "float", "default": 0.01, "min": 0, "max": 0.1, "doc": "velocity lost per substep" },
    "gravity": { "type": "float", "default": 1, "min": 0, "max": 2, "doc": "gravity, in g" },
    "wind": { "type": "float", "default": 1, "min": 0, "max": 3, "doc": "wind strength" },
    "idle": { "type": "float", "default": 0.15, "min": 0, "max": 1, "doc": "wind on silence" },
    "react": { "type": "float", "default": 1, "min": 0, "max": 3, "doc": "how much the bass adds to the wind" },
    "aero": { "type": "float", "default": 1.4, "min": 0, "max": 4, "doc": "how hard the wind presses on the cloth's face" },
    "flutter": { "type": "float", "default": 1, "min": 0, "max": 3, "doc": "turbulence (the highs add to it)" },
    "swing": { "type": "float", "default": 1, "min": 0, "max": 2, "doc": "how far the wind direction swings (slow wander plus the mids)" },
    "gust": { "type": "float", "default": 1, "min": 0, "max": 3, "doc": "onset gust strength (0 = off)" },
    "pattern": { "type": "enum", "default": 0, "options": ["stripes", "spectrum", "chevrons", "gradient"], "doc": "what is printed on the cloth" },
    "stripes": { "type": "int", "default": 3, "min": 1, "max": 9, "doc": "stripe or chevron count" },
    "flash": { "type": "float", "default": 1, "min": 0, "max": 3, "doc": "onset flash" },
    "glow": { "type": "float", "default": 1, "min": 0, "max": 4, "doc": "brightness" },
    "bg": { "type": "float", "default": 1, "min": 0, "max": 3, "doc": "sky brightness" },
    "distance": { "type": "float", "default": 2.2, "min": 1, "max": 6, "doc": "camera distance (the cloth is 1.6 wide)" },
    "cycle": { "type": "float", "default": 0.15, "min": 0, "max": 4, "doc": "palette drift, sweeps per 16 beats" },
    "pulse": { "type": "float", "default": 0.7, "min": 0, "max": 1, "doc": "how much the light swells with the loudness" }
  },
  "budget": { "ms": 0.9, "scales": "res" },
  "tags": ["cloth", "physics", "verlet", "flag", "simulation", "compute", "3d"],
  "author": { "vendor": "claude", "model": "claude-opus-5-5" },
  "changelog": [
    { "date": "2026-11-26", "by": "claude/claude-opus-5-5", "note": "first version" },
    { "date": "2026-11-27", "by": "claude/claude-opus-5-5", "note": "music drives it much harder: quiet hangs nearly limp, bass flies it flat out, stronger onset gusts and flashes, light follows loudness" }
  ]
}
