  "assets": [
    { "path": "assets/vox/fighter.vox", "license": "own", "source": "space_sim" },
    { "path": "assets/vox/bomber.vox", "license": "own", "source": "space_sim" },
    { "path": "assets/vox/corvette.vox", "license": "own", "source": "space_sim" },
    { "path": "assets/vox/agent-ship/shrikeTerran.vox", "license": "own", "source": "space_sim" }
