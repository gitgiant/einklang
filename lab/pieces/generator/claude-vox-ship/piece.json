    "shatter": { "type": "float", "default": 1, "min": 0, "max": 3, "doc": "how far onsets and bass throw the voxels" },
    "glow": { "type": "float", "default": 2, "min": 0, "max": 6, "doc": "band light on the hull" },
    "tint": { "type": "float", "default": 0.35, "min": 0, "max": 1, "doc": "hull colour toward the palette" },
