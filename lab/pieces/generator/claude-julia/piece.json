{
  "id": "claude-julia",
  "kind": "generator",
  "name": "Julia / mandelbox",
  "doc": "Escape-time fractal, a Julia set (z^2 + c) or a 2D mandelbox (box fold, ball fold, scale), smooth-coloured through the palette with a distance-estimate glow along the boundary. c circles the Mandelbrot boundary slowly; smoothed bass pushes it outward and mids lead its phase, so the shape breathes with the music; the view spins and breathes in and out, and onsets flash the boundary.",
  "ports": {
    "in": { "palette": { "type": "palette", "optional": true, "doc": "escape bands ping-pong along the palette; stop 0 shades the interior, the last stop is the boundary glow" } },
    "out": { "out": { "type": "tex" } }
  },
  "params": {
    "mode": { "type": "enum", "default": 0, "options": ["julia", "mandelbox"] },
    "iters": { "type": "int", "default": 200, "min": 32, "max": 600, "doc": "max iterations" },
    "orbit": { "type": "float", "default": 0.7885, "min": 0.3, "max": 1.2, "doc": "radius of c's circle (0.7885 hugs the Mandelbrot boundary)" },
    "period": { "type": "float", "default": 90, "min": 10, "max": 600, "doc": "seconds per turn of c" },
    "phase": { "type": "float", "default": 0, "min": 0, "max": 1, "doc": "starting angle of c in turns" },
    "nudge": { "type": "float", "default": 1, "min": 0, "max": 3, "doc": "how far the music bends c (bass: radius, mids: phase)" },
    "zoom": { "type": "float", "default": 0, "min": 0, "max": 1, "doc": "base magnification, log scale (1 = 60x)" },
    "breathe": { "type": "float", "default": 32, "min": 0, "max": 128, "doc": "beats per zoom in-and-out (0 = still)" },
    "depth": { "type": "float", "default": 6, "min": 1, "max": 40, "doc": "how far each breath zooms in" },
    "fx": { "type": "float", "default": 0, "min": -2, "max": 2, "doc": "zoom focus x on the plane" },
    "fy": { "type": "float", "default": 0, "min": -2, "max": 2, "doc": "zoom focus y on the plane" },
    "spin": { "type": "float", "default": 0.01, "min": -0.2, "max": 0.2, "doc": "view rotation, turns per second" },
    "box": { "type": "float", "default": -1.8, "min": -2.8, "max": 2.8, "doc": "mandelbox scale (keep |box| above 1.3)" },
    "density": { "type": "float", "default": 0.06, "min": 0.005, "max": 0.5, "doc": "palette sweeps per escape iteration" },
    "edge": { "type": "float", "default": 1.5, "min": 0.1, "max": 12, "doc": "boundary glow width in pixels" },
    "glow": { "type": "float", "default": 1, "min": 0, "max": 4, "doc": "brightness" },
    "flash": { "type": "float", "default": 1, "min": 0, "max": 3, "doc": "onset flash of the boundary" },
    "inner": { "type": "float", "default": 1, "min": 0, "max": 3, "doc": "interior (orbit trap) brightness" },
    "cycle": { "type": "float", "default": 0.25, "min": 0, "max": 4, "doc": "palette drift, sweeps per 16 beats" },
    "aa": { "type": "bool", "default": false, "doc": "4x supersampling (about 4x the cost)" }
  },
  "budget": { "ms": 1.2, "scales": "res" },
  "tags": ["fractal", "julia", "mandelbox", "escape-time"],
  "author": { "vendor": "claude", "model": "claude-opus-5-5" },
  "changelog": [{ "date": "2026-11-26", "by": "claude/claude-opus-5-5", "note": "first version" }]
}
