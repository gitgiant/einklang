{
  "id": "claude-wire-ridges", "kind": "generator", "name": "Wireframe mountains",
  "doc": "Synthwave flyover: rows of wireframe ridges march toward the camera one row per beat, with a flat valley floor down the middle and peaks rising at the sides. The spectrum lifts the peaks (bass near the valley, highs at the edges), each beat's row flashes, and the camera sways. Hidden lines are removed (painter's order); transparent sky above (premultiplied: blend with 'over').",
  "ports": { "in": { "palette": { "type": "palette", "optional": true } }, "out": { "out": { "type": "tex" } } },
  "params": {
    "horizon": { "type": "float", "default": 0.55, "min": 0.2, "max": 0.9 },
    "beats": { "type": "float", "default": 0, "min": 0, "max": 1024, "doc": "bind to claude-beat-clock.out, range [0, 1024]" },
    "speed": { "type": "float", "default": 1, "min": 0, "max": 4, "doc": "rows per beat" },
    "rows": { "type": "int", "default": 36, "min": 8, "max": 64 },
    "height": { "type": "float", "default": 1.4, "min": 0.1, "max": 4, "doc": "peak height (camera sits at 0.5)" },
    "valley": { "type": "float", "default": 1.2, "min": 0, "max": 6, "doc": "half-width of the flat valley" },
    "audio": { "type": "float", "default": 1.2, "min": 0, "max": 4, "doc": "how much the spectrum lifts the peaks" },
    "sway": { "type": "float", "default": 0.6, "min": 0, "max": 3 },
    "tint": { "type": "float", "default": 0.35, "min": 0, "max": 1, "doc": "palette position of the near lines (far lines go toward tint + 0.4)" },
    "glow": { "type": "float", "default": 1.8, "min": 0, "max": 6 },
    "fill": { "type": "float", "default": 0.06, "min": 0, "max": 1, "doc": "brightness of the solid between the lines" }
  },
  "shader": "ridges.wgsl", "budget": { "ms": 1.5, "scales": "res" },
  "tags": ["synthwave", "outrun", "mountains", "wireframe", "terrain", "spectrum", "retro"],
  "author": { "vendor": "claude", "model": "claude-opus-5-5" },
  "changelog": [{ "date": "2026-11-26", "by": "claude-opus-5-5", "note": "first version (vaporwave/synthwave batch)" }]
}
