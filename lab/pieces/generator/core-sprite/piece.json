{
  "id": "core-sprite",
  "kind": "generator",
  "name": "Sprite",
  "doc": "A pixel-art sprite sheet (.spr) drawn pixel-perfect: one sprite, a row (a crowd, each a step out of phase) or tiles. Frames step to the beat; bass bounces it; optional palette swap and outline. Add a sheet: import it with `npm run lab -- sprite import`, list it in assets, and add its name to the sheet options.",
  "ports": {
    "in": { "palette": { "type": "palette", "optional": true, "doc": "palette swap target" } },
    "out": { "out": { "type": "tex" } }
  },
  "params": {
    "sheet": { "type": "enum", "default": 0, "options": ["dancer", "sparkle", "heart", "note"] },
    "mode": { "type": "enum", "default": 0, "options": ["single", "row", "tile"] },
    "size": { "type": "float", "default": 0.4, "min": 0.03, "max": 1, "doc": "sprite height in screen heights (snapped to whole pixels)" },
    "x": { "type": "float", "default": 0.5, "min": 0, "max": 1 },
    "y": { "type": "float", "default": 0.5, "min": 0, "max": 1 },
    "per_beat": { "type": "float", "default": 2, "min": 0.25, "max": 8, "doc": "frames per beat" },
    "count": { "type": "int", "default": 5, "min": 1, "max": 32, "doc": "row: how many" },
    "bounce": { "type": "float", "default": 0.5, "min": 0, "max": 1, "doc": "jump on the bass" },
    "swap": { "type": "float", "default": 0, "min": 0, "max": 1, "doc": "recolour from the palette by brightness" },
    "outline": { "type": "float", "default": 0.6, "min": 0, "max": 1 },
    "glow": { "type": "float", "default": 1.2, "min": 0, "max": 4, "doc": "brightness (HDR)" }
  },
  "assets": [
    { "path": "assets/sprites/dancer.spr", "license": "own", "source": "code-drawn" },
    { "path": "assets/sprites/sparkle.spr", "license": "own", "source": "code-drawn" },
    { "path": "assets/sprites/heart.spr", "license": "own", "source": "code-drawn" },
    { "path": "assets/sprites/note.spr", "license": "own", "source": "code-drawn" }
  ],
  "budget": { "ms": 0.3, "scales": "res" },
  "tags": ["sprite", "pixel", "retro", "core"],
  "author": { "vendor": "core", "model": "claude-opus-5-5" },
  "changelog": [{ "date": "2026-11-26", "by": "claude-opus-5-5", "note": "first version (#26)" }]
}
