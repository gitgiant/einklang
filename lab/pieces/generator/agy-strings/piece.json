{
  "id": "agy-strings",
  "kind": "generator",
  "name": "Harmonic string sim",
  "doc": "Coupled 1D damped wave-equation simulation across resonant strings plucked by audio bands, onsets, and waveform, with standing-wave interference glow.",
  "ports": {
    "in": {
      "palette": {
        "type": "palette",
        "optional": true
      },
      "wave": {
        "type": "wave",
        "optional": true,
        "doc": "Optional stereo waveform to bow the string array."
      }
    },
    "out": {
      "out": {
        "type": "tex"
      }
    }
  },
  "params": {
    "strings": {
      "type": "int",
      "default": 12,
      "min": 4,
      "max": 16,
      "doc": "number of resonant vibrating strings"
    },
    "tension": {
      "type": "float",
      "default": 0.58,
      "min": 0.1,
      "max": 1.0,
      "doc": "wave propagation speed and pitch tension"
    },
    "damping": {
      "type": "float",
      "default": 0.945,
      "min": 0.8,
      "max": 0.985,
      "doc": "string sustain damping"
    },
    "pluck": {
      "type": "float",
      "default": 1.3,
      "min": 0.2,
      "max": 3.0,
      "doc": "audio excitation and pluck strength"
    },
    "glow": {
      "type": "float",
      "default": 1.45,
      "min": 0.3,
      "max": 3.5,
      "doc": "string luminescence"
    },
    "harmonics": {
      "type": "float",
      "default": 0.65,
      "min": 0,
      "max": 1.5,
      "doc": "acoustic interference field shimmer"
    }
  },
  "budget": {
    "ms": 0.6,
    "scales": "res"
  },
  "tags": [
    "strings",
    "wave",
    "sim",
    "physics",
    "harmonics"
  ],
  "author": {
    "vendor": "agy",
    "model": "gemini-4-neon-high"
  }
}
