{
  "id": "claude-synth-sun", "kind": "generator", "name": "Slatted sunset sun",
  "doc": "Synthwave sky: a palette gradient from the zenith (stop 0) to the horizon (~0.35), a haze line, and a sun graded top (stop 1) to bottom (~0.5) whose slats widen toward the horizon and scroll down one step per beat. Bass swells it, highs make the halo shimmer.",
  "ports": { "in": { "palette": { "type": "palette", "optional": true } }, "out": { "out": { "type": "tex" } } },
  "params": {
    "horizon": { "type": "float", "default": 0.62, "min": 0.2, "max": 0.95, "doc": "horizon height (uv y, 0 = top)" },
    "size": { "type": "float", "default": 0.28, "min": 0.05, "max": 0.6, "doc": "sun radius in screen heights" },
    "x": { "type": "float", "default": 0.5, "min": 0, "max": 1 },
    "rise": { "type": "float", "default": 0.55, "min": -1, "max": 1, "doc": "how much of the sun is above the horizon (radii)" },
    "slats": { "type": "float", "default": 9, "min": 0, "max": 24, "doc": "slat count across the sun (0 = solid disc)" },
    "beats": { "type": "float", "default": 0, "min": 0, "max": 1024, "doc": "bind to claude-beat-clock.out, range [0, 1024]" },
    "scroll": { "type": "float", "default": 0.5, "min": -2, "max": 2, "doc": "slat steps per beat" },
    "pulse": { "type": "float", "default": 0.25, "min": 0, "max": 1, "doc": "bass swell of the radius" },
    "glow": { "type": "float", "default": 0.8, "min": 0, "max": 4 },
    "sky": { "type": "float", "default": 1, "min": 0, "max": 2, "doc": "sky gradient brightness" },
    "bright": { "type": "float", "default": 1.6, "min": 0, "max": 6, "doc": "sun brightness" }
  },
  "shader": "sun.wgsl", "budget": { "ms": 0.2, "scales": "res" },
  "tags": ["synthwave", "outrun", "vaporwave", "sun", "sky", "retro"],
  "author": { "vendor": "claude", "model": "claude-opus-5-5" },
