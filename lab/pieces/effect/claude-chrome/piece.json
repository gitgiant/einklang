{
  "id": "claude-chrome", "kind": "effect", "name": "Chrome lettering",
  "doc": "Turns premultiplied text or sprites (core-text) into 80s chrome: a sky-to-white top half, a hard dark horizon, a sunset-orange bottom, a highlight sweeping across on the beat and a neon outline from the palette that flares with bass. Keeps alpha, so blend the result with 'over'.",
  "ports": { "in": { "in": { "type": "tex" }, "palette": { "type": "palette", "optional": true } }, "out": { "out": { "type": "tex" } } },
  "params": {
    "y": { "type": "float", "default": 0.5, "min": 0, "max": 1, "doc": "centre of the lettering (uv y)" },
    "height": { "type": "float", "default": 0.2, "min": 0.02, "max": 1, "doc": "height of the lettering band" },
    "beats": { "type": "float", "default": 0, "min": 0, "max": 1024, "doc": "bind to claude-beat-clock.out, range [0, 1024]" },
    "sweep": { "type": "float", "default": 0.25, "min": 0, "max": 2, "doc": "highlight passes per beat" },
    "outline": { "type": "float", "default": 0.006, "min": 0, "max": 0.03, "doc": "outline radius (screen heights)" },
    "neon": { "type": "float", "default": 1.5, "min": 0, "max": 6, "doc": "outline brightness" },
    "tint": { "type": "float", "default": 0.6, "min": 0, "max": 1, "doc": "palette position of the outline" },
    "bright": { "type": "float", "default": 1.4, "min": 0, "max": 4 }
  },
  "shader": "chrome.wgsl", "budget": { "ms": 0.2, "scales": "res" },
  "tags": ["chrome", "text", "synthwave", "outrun", "retro"],
  "author": { "vendor": "claude", "model": "claude-opus-5-5" },
  "changelog": [{ "date": "2026-11-26", "by": "claude-opus-5-5", "note": "first version (vaporwave/synthwave batch)" }]
}
