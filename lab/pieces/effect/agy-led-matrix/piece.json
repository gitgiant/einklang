{
  "id": "agy-led-matrix",
  "kind": "effect",
  "name": "LED matrix spectrum",
  "doc": "Physical domed LED diode array with PCB bezel spacing, input quantization, 16-band LED spectrum columns, and falling peak-hold persistence.",
  "ports": {
    "in": {
      "in": {
        "type": "tex"
      },
      "palette": {
        "type": "palette",
        "optional": true
      }
    },
    "out": {
      "out": {
        "type": "tex"
      }
    }
  },
  "params": {
    "cols": {
      "type": "int",
      "default": 64,
      "min": 16,
      "max": 128,
      "doc": "horizontal LED column count"
    },
    "dot": {
      "type": "float",
      "default": 0.78,
      "min": 0.35,
      "max": 0.96,
      "doc": "LED diode diameter inside each cell"
    },
    "spec_mix": {
      "type": "float",
      "default": 0.6,
      "min": 0,
      "max": 1.2,
      "doc": "16-band LED VU spectrum column intensity"
    },
    "bezel": {
      "type": "float",
      "default": 0.22,
      "min": 0,
      "max": 0.8,
      "doc": "ambient unlit LED housing reflection"
    },
    "bloom": {
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1.5,
      "doc": "soft diode lens bleed onto the bezel"
    },
    "decay": {
      "type": "float",
      "default": 0.84,
      "min": 0,
      "max": 0.95,
      "doc": "LED persistence and falling peak-hold decay"
    }
  },
  "shader": "led_matrix.wgsl",
  "feedback": true,
  "budget": {
    "ms": 0.35,
    "scales": "res"
  },
  "tags": [
    "led",
    "matrix",
    "spectrum",
    "stylize",
    "feedback"
  ],
  "author": {
    "vendor": "agy",
    "model": "gemini-4-neon-high"
  }
}
