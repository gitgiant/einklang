{
  "id": "claude-luma-terrain", "kind": "effect", "name": "Luma terrain flyover",
  "doc": "The picture's brightness raised into a mirrored, endless 3D terrain and flown over low: the image (or the palette) colours the ground, the bass lifts the mountains, each beat surges the camera forward and runs a glowing contour line across the land, onsets flash the ridges.",
  "ports": {
    "in": {
      "height": { "type": "mask", "doc": "heights 0..1, e.g. core-media.luma" },
      "in": { "type": "tex", "optional": true, "doc": "ground colours (colour mode: picture)" },
      "palette": { "type": "palette", "optional": true, "doc": "sky, fog and contour colours" }
    },
    "out": { "out": { "type": "tex" } }
  },
  "params": {
    "height": { "type": "float", "default": 1.0, "min": 0, "max": 3, "doc": "mountain height (world units; the camera flies at about 1.3)" },
    "bass": { "type": "float", "default": 0.6, "min": 0, "max": 1.5, "doc": "the bass lifts the mountains" },
    "speed": { "type": "float", "default": 1.2, "min": 0, "max": 6, "doc": "flight speed, world units per second" },
    "surge": { "type": "float", "default": 0.6, "min": 0, "max": 2, "doc": "forward lurch on each beat" },
    "scale": { "type": "float", "default": 6, "min": 2, "max": 20, "doc": "world size of one image tile (it mirrors on)" },
    "pitch": { "type": "float", "default": 0.22, "min": 0, "max": 0.8, "doc": "how far the camera looks down" },
    "bank": { "type": "float", "default": 0.5, "min": 0, "max": 1, "doc": "weaving and banking of the flight path" },
    "colour": { "type": "enum", "default": 0, "options": ["picture", "palette", "picture + palette"] },
    "contour": { "type": "float", "default": 0.8, "min": 0, "max": 3, "doc": "glowing height lines (the beat sweeps one across the land)" },
    "grid": { "type": "float", "default": 0.0, "min": 0, "max": 2, "doc": "neon ground grid" },
    "fog": { "type": "float", "default": 0.05, "min": 0, "max": 0.3 }
  },
  "shader": "terrain.wgsl", "budget": { "ms": 2.5, "scales": "res" },
  "tags": ["3d", "heightmap", "terrain", "raymarch", "flight", "media"],
  "author": { "vendor": "claude", "model": "claude-opus-5-5" }
}
