{
  "id": "claude-crt", "kind": "effect", "name": "CRT / VHS finish",
  "doc": "Tube finish: barrel curvature with a dark bezel, aperture-grille mask, scanlines, RGB convergence error that kicks with bass and onsets, a rolling VHS tracking band that tears on onsets, tape noise and a vignette.",
  "ports": { "in": { "in": { "type": "tex" } }, "out": { "out": { "type": "tex" } } },
  "params": {
    "curve": { "type": "float", "default": 0.12, "min": 0, "max": 0.5, "doc": "barrel distortion" },
    "lines": { "type": "float", "default": 360, "min": 60, "max": 1080, "doc": "scanlines per screen height" },
    "scan": { "type": "float", "default": 0.35, "min": 0, "max": 1, "doc": "scanline depth" },
    "mask": { "type": "float", "default": 0.15, "min": 0, "max": 1, "doc": "aperture grille" },
    "shift": { "type": "float", "default": 0.0015, "min": 0, "max": 0.02, "doc": "base RGB offset (uv)" },
    "kick": { "type": "float", "default": 0.004, "min": 0, "max": 0.03, "doc": "extra RGB offset on bass/onset" },
    "track": { "type": "float", "default": 0.3, "min": 0, "max": 2, "doc": "VHS tracking band" },
    "noise": { "type": "float", "default": 0.04, "min": 0, "max": 0.5 },
    "vignette": { "type": "float", "default": 0.5, "min": 0, "max": 2 }
  },
  "shader": "crt.wgsl", "budget": { "ms": 0.2, "scales": "res" },
  "tags": ["crt", "vhs", "scanlines", "chromatic", "retro", "vaporwave"],
  "author": { "vendor": "claude", "model": "claude-opus-5-5" },
  "changelog": [{ "date": "2026-11-26", "by": "claude-opus-5-5", "note": "first version (vaporwave/synthwave batch)" }]
}
